# Build für nbbv-basketball.de/spielboerse/ (Strato), gebaut vom Workflow
# deploy-spielboerse.yml im Repo Erikk87/nbbv-webservices mit: vite build --mode strato
# Nur öffentliche Werte – landen ohnehin im ausgelieferten JavaScript.
# Für /dev/spielboerse/ überschreibt der Workflow VITE_API_BASE_URL und VITE_APP_TITLE.

# API bleibt auf dem eigenen Server
VITE_API_BASE_URL=https://nbbv-sr-basar.de/api/v1/

VITE_APP_TITLE=NBBV-Spielbörse
VITE_APP_VERSION=2.0.10
VITE_APP_DESCRIPTION=Spielbörse für Schiedsrichter:innen des NBBV

VITE_GITHUB_FRONTEND_URL=https://github.com/Erikk87/srbasar-frontend
VITE_GITHUB_BACKEND_URL=https://github.com/Erikk87/srbasar-backend

# Oberfläche (siehe .env.sample)
VITE_ENABLE_BEZIRK_FILTER=true
VITE_SITE_NAME=Spielbörse
VITE_SITE_TAGLINE=für Schiedsrichter:innen
VITE_OPERATOR_NAME=Niedersächsisch-Bremischer Basketballverband e.V.
VITE_CONTACT_EMAIL=support@nbbv.de
VITE_IMPRINT_URL=https://www.nbbv.de/de/rechtliches/impressum/
VITE_PRIVACY_URL=https://www.nbbv.de/de/rechtliches/datenschutz/
VITE_SUPPORT_ENABLED=false
VITE_COMPACT_HEADING=true
VITE_FIXED_THEME=light
VITE_NBBV_HEADER=true
VITE_NBBV_FOOTER=true
VITE_INFO_URL=https://www.nbbv.de/de/sport/schiedsrichter_innen/sr-spielboerse/
VITE_SITE_LOGO=nbbv-logo.png
VITE_SITE_LOGO_LINK=https://www.nbbv.de
VITE_SITE_LOGO_ALT=Niedersächsisch-Bremischer Basketballverband e.V.
